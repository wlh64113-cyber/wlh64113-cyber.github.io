---
import { getCollection } from 'astro:content';
import '../styles/global.css';
import '../styles/cyborg.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Blog of Even｜技术学习与知识沉淀',
  description = '一个持续生长的个人技术学习系统，记录学习路线、技术文章与实践总结。',
} = Astro.props;

const pathname = Astro.url.pathname;
const isHome = pathname === '/';
const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const navItems = [
  { href: '/', label: '首页', icon: '⌂' },
  { href: '/archive', label: '归档', icon: '◷' },
  { href: '/tags', label: '标签', icon: '#' },
  { href: '/categories', label: '分类', icon: '▦' },
  { href: '/learn', label: '学习', icon: '✦' },
  { href: '/about', label: '关于', icon: '◎' },
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname.startsWith(href);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#8fbc8f" />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem('even-theme');
        const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      })();
    </script>
  </head>
  <body class:list={[{ 'is-home': isHome }]}> 
    <header class="blog-header">
      <div class="blog-header-inner">
        <a class="blog-brand" href="/" aria-label="Blog of Even 首页">
          <strong>Blog of Even</strong>
        </a>

        <nav class="blog-nav" aria-label="主导航">
          {navItems.map((item) => (
            <a href={item.href} class:list={[{ active: isActive(item.href) }]}>
              <span class="nav-icon" aria-hidden="true">{item.icon}</span>{item.label}
            </a>
          ))}
        </nav>

        <div class="header-actions">
          <button id="open-search" class="icon-button" type="button" aria-label="搜索" title="搜索（Ctrl/Cmd + K）">⌕</button>
          <button id="theme-toggle" class="icon-button" type="button" aria-label="切换昼夜模式">◐</button>
        </div>
      </div>
    </header>

    <div class="blog-container">
      <slot />
    </div>

    <footer class="blog-footer">
      <p>© 2026 Even · Blog of Even</p>
      <p>持续学习 · 持续输出 · 持续构建</p>
    </footer>

    <div id="search-overlay" class="search-overlay" hidden>
      <div class="search-dialog" role="dialog" aria-modal="true" aria-label="搜索文章">
        <div class="search-dialog-head">
          <strong>搜索文章</strong>
          <button id="close-search" class="icon-button" type="button" aria-label="关闭">×</button>
        </div>
        <input id="global-search" class="global-search-input" type="search" placeholder="输入标题、分类或标签…" autocomplete="off" />
        <div id="global-search-results" class="global-search-results">
          {articles.map((article) => (
            <a href={`/blog/${article.id}/`} data-search={`${article.data.title} ${article.data.description} ${article.data.category} ${article.data.tags.join(' ')}`.toLowerCase()}>
              <strong>{article.data.title}</strong>
              <span>{article.data.pubDate.toLocaleDateString('zh-CN')} · {article.data.category}</span>
            </a>
          ))}
        </div>
      </div>
    </div>

    <button id="back-to-top" class="back-to-top" type="button" aria-label="返回顶部">↑</button>

    <script>
      const root = document.documentElement;
      const themeButton = document.querySelector('#theme-toggle');
      themeButton?.addEventListener('click', () => {
        const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
        root.dataset.theme = next;
        localStorage.setItem('even-theme', next);
      });

      const overlay = document.querySelector('#search-overlay');
      const openSearch = document.querySelector('#open-search');
      const closeSearch = document.querySelector('#close-search');
      const searchInput = document.querySelector('#global-search');
      const searchRows = [...document.querySelectorAll('#global-search-results a')];
      const showSearch = () => {
        if (!overlay) return;
        overlay.hidden = false;
        document.body.classList.add('search-open');
        setTimeout(() => searchInput?.focus(), 0);
      };
      const hideSearch = () => {
        if (!overlay) return;
        overlay.hidden = true;
        document.body.classList.remove('search-open');
      };
      openSearch?.addEventListener('click', showSearch);
      closeSearch?.addEventListener('click', hideSearch);
      overlay?.addEventListener('click', (event) => { if (event.target === overlay) hideSearch(); });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') hideSearch();
        if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
          event.preventDefault();
          showSearch();
        }
      });
      searchInput?.addEventListener('input', () => {
        const query = searchInput.value.trim().toLowerCase();
        searchRows.forEach((row) => row.hidden = !!query && !row.dataset.search?.includes(query));
      });

      const backTop = document.querySelector('#back-to-top');
      const syncBackTop = () => backTop?.classList.toggle('visible', window.scrollY > 420);
      window.addEventListener('scroll', syncBackTop, { passive: true });
      backTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      syncBackTop();
    </script>
  </body>
</html>
