---
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lessons = await getCollection('learning');
const tags = [...new Set(articles.flatMap((article) => article.data.tags))];
const categories = [...new Set(articles.map((article) => article.data.category))];
const categoryLabel = (category: string) => category === 'Engineering' ? '工程实践' : category;
const categoryCounts = categories.map((category) => ({
  category,
  count: articles.filter((article) => article.data.category === category).length,
}));
---

<aside class="blog-sidebar">
  <section class="sidebar-card profile-card">
    <div class="profile-avatar">E</div>
    <h2>Even</h2>
    <p>记录技术学习、科研阅读与工程实践，把零散知识沉淀成长期资产。</p>
    <div class="profile-stats">
      <a href="/archive"><strong>{articles.length}</strong><span>文章</span></a>
      <a href="/tags"><strong>{tags.length}</strong><span>标签</span></a>
      <a href="/categories"><strong>{categories.length}</strong><span>分类</span></a>
    </div>
    <a class="sidebar-github" href="https://github.com/wlh64113-cyber" target="_blank" rel="noreferrer">访问 GitHub ↗</a>
  </section>

  <section class="sidebar-card sidebar-quote">
    <span>公告</span>
    <p>欢迎来到 Blog of Even。网站会持续更新学习路线、技术文章和项目实践记录。</p>
  </section>

  <section class="sidebar-card">
    <h3 class="card-headline">学习系统</h3>
    <div class="sidebar-learning">
      <div><strong>{lessons.length}</strong> <span>节学习内容</span></div>
      <a href="/learn">查看全部学习路线 →</a>
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="card-headline">最新文章</h3>
    <div class="sidebar-post-list">
      {articles.slice(0, 5).map((article) => (
        <a href={`/blog/${article.id}/`}>
          <span class="sidebar-thumb">{article.data.category.slice(0, 1).toUpperCase()}</span>
          <span class="sidebar-post-copy">
            <span>{article.data.title}</span>
            <time>{article.data.pubDate.toLocaleDateString('zh-CN')}</time>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="card-headline">文章分类</h3>
    <div class="sidebar-category-list">
      {categoryCounts.map(({ category, count }) => (
        <a href={`/blog?category=${encodeURIComponent(category)}`}>
          <span>{categoryLabel(category)}</span>
          <span>{count}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="sidebar-card">
    <h3 class="card-headline">热门标签</h3>
    <div class="sidebar-tags">
      {tags.slice(0, 14).map((tag) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
    </div>
  </section>
</aside>
