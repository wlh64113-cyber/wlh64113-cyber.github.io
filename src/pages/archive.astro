---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const grouped = articles.reduce((acc, article) => {
  const year = article.data.pubDate.getFullYear();
  (acc[year] ??= []).push(article);
  return acc;
}, {} as Record<number, typeof articles>);
const years = Object.keys(grouped).map(Number).sort((a, b) => b - a);
---

<BaseLayout title="文章归档｜Blog of Even" description="按时间浏览 Blog of Even 的技术文章。">
  <section class="archive-hero">
    <h1>文章归档</h1>
    <p>按时间回看学习、实践和知识沉淀的轨迹。</p>
  </section>

  <div class="blog-layout">
    <main class="blog-main archive-list">
      {years.map((year) => (
        <section class="archive-year">
          <h2>{year}</h2>
          {grouped[year].map((article) => (
            <div class="archive-item">
              <time>{article.data.pubDate.toLocaleDateString('zh-CN')}</time>
              <a href={`/blog/${article.id}/`}>{article.data.title}</a>
            </div>
          ))}
        </section>
      ))}
    </main>
    <Sidebar />
  </div>
</BaseLayout>
