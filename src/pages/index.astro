---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lessons = await getCollection('learning');
const tracks = new Set(lessons.map((lesson) => lesson.data.track));
const latestArticles = articles.slice(0, 3);
---

<BaseLayout>
  <main>
    <section class="hero hero-grid">
      <div class="hero-copy">
        <span class="section-kicker">个人技术学习与知识系统</span>
        <h1>把学过的东西，<span class="gradient-text">真正沉淀下来。</span></h1>
        <p class="lead">
          用学习路线组织输入，用技术文章沉淀理解，用项目实践验证知识。这里不是笔记堆积，而是一套持续生长的个人学习系统。
        </p>
        <div class="actions">
          <a class="button" href="/learn">进入学习系统 <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/blog">浏览技术文章</a>
        </div>
      </div>

      <aside class="hero-panel" aria-label="知识库概览">
        <div class="hero-panel-head">
          <span>知识库概览</span>
          <span class="live-dot"><i></i> 持续更新</span>
        </div>
        <div class="metric-grid">
          <div class="metric-card">
            <strong>{tracks.size}</strong>
            <span>条学习路线</span>
          </div>
          <div class="metric-card">
            <strong>{lessons.length}</strong>
            <span>节学习内容</span>
          </div>
          <div class="metric-card">
            <strong>{articles.length}</strong>
            <span>篇技术文章</span>
          </div>
        </div>
        <div class="hero-note">
          <span class="feature-icon small">⌘</span>
          <div>
            <strong>学习 → 理解 → 输出 → 实践</strong>
            <p>让每一次学习都进入可复用的知识结构。</p>
          </div>
        </div>
      </aside>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">核心模块</span>
          <h2>一套系统，承载整个技术成长过程</h2>
        </div>
      </div>

      <div class="feature-grid">
        <a class="feature-card" href="/learn">
          <span class="feature-icon">学</span>
          <div>
            <span class="card-label">学习系统</span>
            <h3>按路线学习，而不是随机收藏</h3>
            <p>围绕技术主题组织课程顺序、学习时长和完成进度，让知识输入有明确路径。</p>
          </div>
          <span class="card-arrow">进入学习 →</span>
        </a>

        <a class="feature-card" href="/blog">
          <span class="feature-icon">文</span>
          <div>
            <span class="card-label">文章系统</span>
            <h3>把理解沉淀成可检索的文章</h3>
            <p>使用 Markdown 写作，支持分类、标签、搜索和独立详情页，形成长期知识库。</p>
          </div>
          <span class="card-arrow">浏览文章 →</span>
        </a>

        <a class="feature-card" href="https://github.com/wlh64113-cyber" target="_blank" rel="noreferrer">
          <span class="feature-icon">码</span>
          <div>
            <span class="card-label">项目实践</span>
            <h3>让知识最终落到真实项目里</h3>
            <p>通过代码、实验和工程实践检验学习结果，让“知道”逐步变成“会做”。</p>
          </div>
          <span class="card-arrow">查看 GitHub ↗</span>
        </a>
      </div>
    </section>

    <section class="section">
      <div class="section-heading">
        <div>
          <span class="section-kicker">最新沉淀</span>
          <h2>最近更新的技术文章</h2>
        </div>
        <a class="text-link" href="/blog">查看全部文章 →</a>
      </div>

      <div class="article-preview-grid">
        {latestArticles.map((article) => (
          <a class="article-preview-card" href={`/blog/${article.id}/`}>
            <div class="meta-line">
              <span>{article.data.pubDate.toLocaleDateString('zh-CN')}</span>
              <span>{article.data.category === 'Engineering' ? '工程实践' : article.data.category}</span>
            </div>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
            <div class="tag-list">
              {article.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
