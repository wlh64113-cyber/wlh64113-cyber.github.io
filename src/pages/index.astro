---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lessons = await getCollection('learning');
const tags = new Set(articles.flatMap((article) => article.data.tags));
const categories = new Set(articles.map((article) => article.data.category));
const categoryLabel = (category: string) => category === 'Engineering' ? '工程实践' : category;
---

<BaseLayout>
  <section class="blog-home-intro">
    <h1>Blog of Even</h1>
    <p>记录技术学习、科研阅读与工程实践。把零散的输入整理成可检索、可复用、可持续生长的知识。</p>
    <div class="blog-home-stats">
      <span>文章 <strong>{articles.length}</strong></span>
      <span>标签 <strong>{tags.size}</strong></span>
      <span>分类 <strong>{categories.size}</strong></span>
      <span>学习内容 <strong>{lessons.length}</strong></span>
    </div>
  </section>

  <div class="blog-layout">
    <main class="blog-main">
      <div class="post-feed">
        {articles.map((article) => (
          <article class="post-card">
            <div class="post-meta">
              <span>发表于 {article.data.pubDate.toLocaleDateString('zh-CN')}</span>
              <span>·</span>
              <a href={`/blog?category=${encodeURIComponent(article.data.category)}`}>{categoryLabel(article.data.category)}</a>
            </div>
            <h2><a href={`/blog/${article.id}/`}>{article.data.title}</a></h2>
            <p class="post-excerpt">{article.data.description}</p>
            <div class="post-tags">
              {article.data.tags.map((tag) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
            </div>
            <a class="read-more" href={`/blog/${article.id}/`}>阅读全文 →</a>
          </article>
        ))}

        {articles.length === 0 && (
          <article class="post-card">
            <h2>文章正在整理中</h2>
            <p class="post-excerpt">可以从学习系统开始浏览，后续技术文章会持续补充。</p>
            <a class="read-more" href="/learn">进入学习系统 →</a>
          </article>
        )}
      </div>
    </main>

    <Sidebar />
  </div>
</BaseLayout>
