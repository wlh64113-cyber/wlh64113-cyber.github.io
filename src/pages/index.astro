---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const lessons = await getCollection('learning');
const tracks = new Set(lessons.map((lesson) => lesson.data.track));
const latestArticles = articles.slice(0, 3);
---

<BaseLayout>
  <main>
    <section class="hero">
      <p class="eyebrow">Learn · Build · Write · Repeat</p>
      <h1>Blog of Even.</h1>
      <p class="lead">
        一个持续生长的技术学习系统：用学习路线组织知识，用文章沉淀理解，用项目验证实践。
      </p>
      <div class="actions">
        <a class="button" href="/learn">Start learning</a>
        <a class="button secondary" href="/blog">Read articles</a>
      </div>
    </section>

    <section class="section">
      <h2>Two systems, one knowledge base</h2>
      <div class="grid">
        <a class="card card-link" href="/learn">
          <p class="eyebrow">Learning System</p>
          <h3>{tracks.size} Tracks · {lessons.length} Lessons</h3>
          <p>按学习路线组织课程，记录完成状态、预计学习时间和阶段进度。</p>
        </a>
        <a class="card card-link" href="/blog">
          <p class="eyebrow">Article System</p>
          <h3>{articles.length} Articles</h3>
          <p>Markdown 驱动的文章系统，支持分类、标签、搜索以及独立详情页。</p>
        </a>
        <a class="card card-link" href="https://github.com/wlh64113-cyber">
          <p class="eyebrow">Projects</p>
          <h3>Build in public</h3>
          <p>让知识最终落到代码、实验和工程项目，而不是停留在收藏夹。</p>
        </a>
      </div>
    </section>

    <section class="section">
      <h2>Latest articles</h2>
      <div class="grid">
        {latestArticles.map((article) => (
          <a class="card card-link" href={`/blog/${article.id}/`}>
            <p class="eyebrow">{article.data.category}</p>
            <h3>{article.data.title}</h3>
            <p>{article.data.description}</p>
          </a>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
