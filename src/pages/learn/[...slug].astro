---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const lessons = await getCollection('learning');
  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

interface Props {
  lesson: CollectionEntry<'learning'>;
}

const { lesson } = Astro.props;
const { Content } = await render(lesson);
const levelLabel = ({ beginner: '入门', intermediate: '进阶', advanced: '高级' } as Record<string, string>)[lesson.data.level] || lesson.data.level;
---

<BaseLayout title={`${lesson.data.title}｜学习系统｜Blog of Even`} description={lesson.data.description}>
  <main class="page article-page">
    <a class="back-link" href="/learn">← 返回学习系统</a>
    <header class="article-header lesson-header">
      <span class="section-kicker">{lesson.data.track} · 第 {lesson.data.order} 节</span>
      <div class="meta-line article-meta">
        <span>{levelLabel}</span>
        {lesson.data.estimatedMinutes && <span>预计 {lesson.data.estimatedMinutes} 分钟</span>}
      </div>
      <h1>{lesson.data.title}</h1>
      <p class="lead">{lesson.data.description}</p>
      <div class="lesson-actions">
        <button id="complete-lesson" class="button" data-learning-id={lesson.id}>标记为已完成</button>
        <span id="complete-state" class="status-text"></span>
      </div>
    </header>

    <article class="prose markdown-body reading-surface">
      <Content />
    </article>

    <div class="article-end">
      <span>完成这一节后，记得更新学习进度。</span>
      <a class="text-link" href="/learn">返回学习路线 →</a>
    </div>
  </main>

  <script>
    const STORAGE_KEY = 'blog-of-even-learning-progress-v1';
    const button = document.querySelector('#complete-lesson');
    const state = document.querySelector('#complete-state');
    const lessonId = button?.dataset.learningId;

    function loadCompleted() {
      try {
        return new Set(JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]'));
      } catch {
        return new Set();
      }
    }

    let completed = loadCompleted();

    function renderState() {
      if (!lessonId || !button || !state) return;
      const done = completed.has(lessonId);
      button.textContent = done ? '取消完成标记' : '标记为已完成';
      button.classList.toggle('secondary', done);
      state.textContent = done ? '✓ 已完成，进度已保存在当前浏览器' : '完成后可记录学习进度';
    }

    button?.addEventListener('click', () => {
      if (!lessonId) return;
      if (completed.has(lessonId)) completed.delete(lessonId);
      else completed.add(lessonId);
      localStorage.setItem(STORAGE_KEY, JSON.stringify([...completed]));
      renderState();
    });

    renderState();
  </script>
</BaseLayout>
