---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Sidebar from '../components/Sidebar.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categoryLabel = (category: string) => category === 'Engineering' ? '工程实践' : category;
---

<BaseLayout title="技术文章｜Blog of Even" description="技术文章、学习总结与工程实践沉淀。">
  <section class="archive-hero">
    <h1>技术文章</h1>
    <p>把学习过程中的理解、踩坑与实践整理成可以长期回看的文章。</p>
  </section>

  <div class="blog-layout">
    <main class="blog-main">
      <div class="toolbar-panel">
        <div class="search-wrap">
          <span>⌕</span>
          <input id="article-search" class="search-input" type="search" placeholder="搜索标题、分类或标签…" />
        </div>
      </div>

      <div id="post-feed" class="post-feed">
        {articles.map((article, index) => (
          <article
            class="post-card"
            data-category={article.data.category}
            data-tags={article.data.tags.join('|')}
            data-search={`${article.data.title} ${article.data.description} ${article.data.category} ${article.data.tags.join(' ')}`.toLowerCase()}
          >
            <a class="post-cover" href={`/blog/${article.id}/`} aria-label={`阅读 ${article.data.title}`}>
              <span class="post-cover-mark">{article.data.category.slice(0, 1).toUpperCase()}</span>
            </a>
            <div class="post-card-body">
              <div class="post-meta">
                <span>发表于 {article.data.pubDate.toLocaleDateString('zh-CN')}</span>
                <span>·</span>
                <a href={`/blog?category=${encodeURIComponent(article.data.category)}`}>{categoryLabel(article.data.category)}</a>
                <span>·</span>
                <span>第 {index + 1} 篇</span>
              </div>
              <h2><a href={`/blog/${article.id}/`}>{article.data.title}</a></h2>
              <p class="post-excerpt">{article.data.description}</p>
              <div class="post-tags">
                {article.data.tags.map((tag) => <a href={`/blog?tag=${encodeURIComponent(tag)}`}>#{tag}</a>)}
              </div>
              <a class="read-more" href={`/blog/${article.id}/`}>阅读全文 →</a>
            </div>
          </article>
        ))}
      </div>
    </main>

    <Sidebar />
  </div>

  <script>
    const input = document.querySelector('#article-search');
    const posts = [...document.querySelectorAll('#post-feed .post-card')];
    const params = new URLSearchParams(location.search);
    const selectedTag = params.get('tag');
    const selectedCategory = params.get('category');

    function filterPosts() {
      const query = (input?.value || '').trim().toLowerCase();
      posts.forEach((post) => {
        const matchesText = !query || post.dataset.search?.includes(query);
        const tags = (post.dataset.tags || '').split('|');
        const matchesTag = !selectedTag || tags.includes(selectedTag);
        const matchesCategory = !selectedCategory || post.dataset.category === selectedCategory;
        post.hidden = !(matchesText && matchesTag && matchesCategory);
      });
    }

    if (selectedTag && input) input.placeholder = `当前标签：${selectedTag}，继续搜索…`;
    if (selectedCategory && input) input.placeholder = `当前分类：${selectedCategory}，继续搜索…`;
    input?.addEventListener('input', filterPosts);
    filterPosts();
  </script>
</BaseLayout>
