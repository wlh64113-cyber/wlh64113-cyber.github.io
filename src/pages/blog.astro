---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const articles = (await getCollection('articles', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categories = [...new Set(articles.map((article) => article.data.category))];
---

<BaseLayout title="Articles · Blog of Even" description="技术文章、科研笔记与工程实践。">
  <main class="page">
    <p class="eyebrow">Knowledge Base</p>
    <h1>Articles</h1>
    <p class="lead">把零散学习记录沉淀为长期可检索、可维护的技术文章。</p>

    <div class="toolbar">
      <input id="article-search" class="search-input" type="search" placeholder="搜索标题、分类或标签…" />
      <div class="chips">
        <button class="chip active" data-category="all">All</button>
        {categories.map((category) => <button class="chip" data-category={category}>{category}</button>)}
      </div>
    </div>

    <section id="article-list" class="article-list">
      {articles.map((article) => (
        <a
          class="article-row"
          href={`/blog/${article.id}/`}
          data-category={article.data.category}
          data-search={`${article.data.title} ${article.data.description} ${article.data.category} ${article.data.tags.join(' ')}`.toLowerCase()}
        >
          <div>
            <div class="meta-line">
              <span>{article.data.pubDate.toISOString().slice(0, 10)}</span>
              <span>{article.data.category}</span>
            </div>
            <h2>{article.data.title}</h2>
            <p>{article.data.description}</p>
            <div class="tag-list">
              {article.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          </div>
          <span class="arrow">→</span>
        </a>
      ))}
    </section>
  </main>

  <script>
    const search = document.querySelector('#article-search');
    const rows = [...document.querySelectorAll('.article-row')];
    const chips = [...document.querySelectorAll('.chip')];
    let category = 'all';

    function filterArticles() {
      const query = (search?.value || '').trim().toLowerCase();
      rows.forEach((row) => {
        const matchesQuery = !query || row.dataset.search?.includes(query);
        const matchesCategory = category === 'all' || row.dataset.category === category;
        row.hidden = !(matchesQuery && matchesCategory);
      });
    }

    search?.addEventListener('input', filterArticles);
    chips.forEach((chip) => chip.addEventListener('click', () => {
      category = chip.dataset.category || 'all';
      chips.forEach((item) => item.classList.toggle('active', item === chip));
      filterArticles();
    }));
  </script>
</BaseLayout>
